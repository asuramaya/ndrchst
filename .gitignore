# Python
**/__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Build
build/
dist/

# Local state. NOTE: runtime data lives at ~/.ndrchst/* by default
# (absolute paths, outside the repo). Do NOT add a bare `servers/` here
# — it would silently swallow src/ndrchst/web/templates/servers/.
*.db
*.db-journal
*.db-wal
*.db-shm
/data/
/logs/

# Cloudflare Wrangler local state
.wrangler/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Env / secrets — never commit credentials. Real secrets live outside the
# repo: systemd EnvironmentFile (~/.config/ndrchst/r2.env on the host),
# GitHub Actions secrets, or the operator's shell env. See SECURITY.md.
.env
.env.local
*.env
r2.env
*.secret
*.secrets
secrets.*
*.pem
*.key
id_rsa*
